# Grafana Configuration
# These environment variables configure the monitoring backend

# Public Grafana URL (accessible from client)
NEXT_PUBLIC_GRAFANA_URL=https://6387-2402-800-61ca-7aea-d56-cd0c-31c8-2816.ngrok-free.app

# Grafana API Key (kept secret on server)
# Get this from: Grafana Admin Panel > Configuration > API Keys
GRAFANA_API_KEY=your-api-key-here

# Optional: Datasource ID (defaults to 1)
GRAFANA_DATASOURCE_ID=1
